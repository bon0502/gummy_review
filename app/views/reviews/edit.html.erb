<% content_for :title, t('.title') %>
<h1 class="title">🌟 レビュー編集 🌟</h1>

<%= form_with model: @review,
              url: review_path(@review),
              method: :patch,
              class: "review-form",
              enctype: "multipart/form-data",
              data: { controller: "image-resize" } do |f| %>

  <div class="form-group">
    <%= f.label :photo_url, "グミ画像（メイン１枚）" %>

    <!-- 既存のメイン画像を表示 -->
    <% if @review.photo_url.present? %>
      <div class="mb-2">
        <%= image_tag @review.photo_url.url, class: "img-thumbnail", style: "max-width: 200px;" %>
        <div class="form-check">
          <%= f.check_box :remove_photo_url, class: "form-check-input" %>
          <%= f.label :remove_photo_url, "この画像を削除", class: "form-check-label" %>
        </div>
      </div>
    <% end %>

    <!-- 新しい画像をアップロード -->
    <%= f.file_field :photo_url,
          data: {
              image_resize_target: "main",
              action: "change->image-resize#resizeMain"
          },
          accept: 'image/*' %>
  </div>

  <!-- サブ画像 -->
  <div class="form-group">
    <label>他のグミたち(複数選択可)</label>

  <% if @review.main_images.any? %>
    <div class="mb-3">
      <p>現在のサブ画像:</p>
      <div class="row" id="main-images-container">
        <%= f.fields_for :main_images do |img_f| %>
          <% unless img_f.object.marked_for_destruction? %>
            <div class="col-md-3 mb-2 main-image-item" data-main-image-id="<%= img_f.object.id %>">
              <% if img_f.object.image.present? %>
                <%= image_tag img_f.object.image.url, class: "img-thumbnail" %>
              <% end %>
              <%= img_f.hidden_field :id %>
              <%= img_f.hidden_field :_destroy, value: '0', class: 'destroy-flag' %>
              <div class="form-check">
                <button type="button" class="btn btn-danger btn-sm remove-image">削除</button>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

      <!-- ⭐️ 新しいサブ画像をアップロード（修正版） -->
  <div class="mb-2">
    <%= f.file_field :main_images_images,
          class: 'form-control',
          multiple: true,
          accept: 'image/*',
          data: {
            image_resize_target: "sub",
            action: "change->image-resize#resizeSub"
          } %>
  </div>

  <div class="form-group">
    <%= f.label :gummy_name, "グミの名前" %>
    <%= f.text_field :gummy_name %>
  </div>

  <div class="form-group">
    <label>総合評価</label>
    <%= f.select :rating, [["⭐️", 1], ["⭐️⭐️", 2], ["⭐️⭐️⭐️", 3], ["⭐️⭐️⭐️⭐️", 4], ["⭐️⭐️⭐️⭐️⭐️", 5]] %>
  </div>

  <!-- 横並び -->
  <div class="row-group">
    <div class="fw-bold">
      <%= f.label :flavor, "🩵フレーバー🩵" %>
      <%= f.text_field :flavor %>
    </div>

    <div class="fw-bold">
      <%= f.label :hardness, "🩶硬さ🩶" %>
      <%= f.select :hardness, [["とてもソフト", 1], ["ソフト", 2], ["普通", 3], ["ハード", 4], ["とてもハード", 5]] %>
    </div>

    <div class="fw-bold">
      <%= f.label :sweetness, "🩷甘さ🩷" %>
      <%= f.select :sweetness, [["甘くない", 1], ["甘さ控えめ", 2], ["甘い", 3], ["少し甘い", 4], ["とても甘い", 5]] %>
    </div>

    <div class="fw-bold">
      <%= f.label :sourness, "💛酸味💛" %>
      <%= f.select :sourness, [["酸っぱくない", 1], ["酸っぱさ控えめ", 2], ["酸っぱい", 3], ["少し酸っぱい", 4], ["とても酸っぱい", 5]] %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :manufacturer_name, "💚メーカー💚" %>
    <%= f.text_field :manufacturer_name %>
  </div>

  <div class="form-group">
    <%= f.label :comment, "⭐グミの特徴⭐" %>
    <%= f.text_area :comment %>
  </div>

  <div class="submit-area">
    <%= f.submit "投稿！" %>
  </div>

<% end %>
