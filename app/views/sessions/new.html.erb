<div class="container">
  <div class="row">
    <div class=" col-md-5 col-lg-5 mx-auto">
      <h1 class="text-center mb-5 mt-5">⭐️ ログイン ⭐️</h1>

      <%= form_with url: login_path do |f| %>
        <div class="form-group mb-3">
          <%= f.label :email %>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="form-group mb-3">
          <%= f.label :password %>
          <%= f.password_field :password, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :remember_me do %>
            <%= f.check_box :remember_me %>
            ログイン状態を保持する
          <% end %>
        </div>
        <div class="text-center">
          <%= f.submit "ログイン", class: "btn btn-pink " %>
        </div>
      <% end %>

      <!-- Google OAuth ログインボタンを追加 -->
      <div class="text-center mt-4 mb-3">
        <p class="login-divider">または</p>
        <%= button_to '/auth/google_oauth2', method: :post, class: 'btn btn-outline-danger', data: { turbo: false } do %>
          <i class="fab fa-google me-2"></i>Google でログイン
        <% end %>
      </div>

      <div class='text-center mt-3'>
        <%= link_to t('.to_register_page'), new_user_path %>
        <%= link_to t('.password_forget'), new_password_reset_path %>
      </div>
    </div>
  </div>
</div>
